# Postgres (Railway จะตั้งให้อัตโนมัติเป็น DATABASE_URL เมื่อแนบ Postgres plugin)
DATABASE_URL=postgres://user:password@localhost:5432/social_poster

# ใช้เข้ารหัส token ที่เก็บในฐานข้อมูล ห้ามใส่ตรงนี้ในโค้ด/commit — ตั้งผ่าน ENV ของ Railway เท่านั้น
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ช่องทางเข้าเว็บ (ตั้งเป็น URL จริงของแอปตอน deploy เช่น https://social-poster.up.railway.app)
APP_BASE_URL=http://localhost:3000

PORT=3000

# ----- Google / YouTube OAuth -----
# สร้างที่ https://console.cloud.google.com/apis/credentials (OAuth client ประเภท Web application)
# Authorized redirect URI: ${APP_BASE_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# เชื่อมช่อง: เปิด ${APP_BASE_URL}/auth/youtube/start?token=<ADMIN_TOKEN>
# จำกัดช่องที่ยอมให้เชื่อม (คั่นด้วย ,) ว่าง = ทุกช่อง เช่น UCoV_6-Ff9uss9eRDrvZMkdw
ALLOWED_YT_CHANNEL_IDS=

# ----- Facebook / Meta (ใช้ได้ใน Development mode ถ้าคุณเป็นแอดมินทั้งแอปและเพจ ไม่ต้องรอ App Review) -----
# สร้างที่ https://developers.facebook.com/apps (ดู docs/facebook-setup.md)
# Valid OAuth Redirect URI: ${APP_BASE_URL}/auth/facebook/callback
# เชื่อมเพจ: เปิด ${APP_BASE_URL}/auth/facebook/start?token=<ADMIN_TOKEN>
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=https://app-production-a4bb.up.railway.app/auth/facebook/callback
# (ไม่บังคับ) จำกัดเพจที่จะบันทึก คั่นด้วย ,
ALLOWED_FB_PAGE_IDS=
# (ไม่บังคับ) reel (ค่าเริ่มต้น) หรือ video
FB_POST_MODE=

# ----- TikTok (สมัครทีหลัง ต้องผ่าน App Review) -----
# สร้างที่ https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ใช้ปกป้อง API และหน้าเว็บ — ตั้งค่าเป็นค่าสุ่มยาวๆ (สร้างด้วยคำสั่งเดียวกับ TOKEN_ENCRYPTION_KEY) ตั้งบน Railway เท่านั้น
ADMIN_TOKEN=

# ----- สตูดิโอสร้างคลิป (/studio.html) -----
# ใช้ให้ Claude เขียนสคริปต์ (และเป็นสมองของ /agents.html) ถ้าไม่ตั้งจะใช้ร่างในเครื่องและเสียงของเครื่องแทน — ตั้งบน Railway เท่านั้น
ANTHROPIC_API_KEY=
# ไม่บังคับ: สร้างภาพฉาก/เสียงพากย์ของสตูดิโอ (xAI)
XAI_API_KEY=

# ----- ยิงแอด (ดึง daily-pick จาก noomrachit/yingad-links มาเป็นฉบับร่าง) — ไม่ตั้งก็ใช้ค่าเริ่มต้น -----
# YINGAD_RAW_BASE=https://raw.githubusercontent.com/noomrachit/yingad-links/main
# YINGAD_HUB_URL=https://noomrachit.github.io/yingad-links/
# YINGAD_TZ=Asia/Jerusalem

# ตัวตั้งเวลาโพสต์ (ยิงโพสต์ที่ตั้งเวลาไว้ทุก 60 วินาที) ใส่ 1 เพื่อปิด
# SCHEDULER_DISABLED=

# ===== สร้างเสียงพูด (TTS) — ตั้ง provider แล้วใส่คีย์ของเจ้านั้นเท่านั้น =====
# TTS_PROVIDER=openai | elevenlabs | google
TTS_PROVIDER=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_TTS_API_KEY=
