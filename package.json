{
  "name": "social-poster",
  "version": "0.1.0",
  "private": true,
  "description": "โพสต์ครั้งเดียว ยิงไปหลายแพลตฟอร์ม (Facebook, TikTok, YouTube, ...) เก็บผลลัพธ์แยกรายแพลตฟอร์ม",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10"
  },
  "engines": {
    "node": ">=20"
  }
}
