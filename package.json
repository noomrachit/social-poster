{
  "name": "social-poster",
  "version": "0.1.0",
  "private": true,
  "description": "โพสต์ครั้งเดียว ยิงไปหลายแพลตฟอร์ม (Facebook, TikTok, YouTube, ...) เก็บผลลัพธ์แยกรายแพลตฟอร์ม",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx src/db/migrate.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^188.0.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "social-poster": "dist/cli.js"
  }
}
