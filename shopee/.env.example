# ===== Shopee Affiliate (Thailand) =====
# ขอจาก https://affiliate.shopee.co.th/open_api (บัญชี affiliate shopee.co.th)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.co.th/graphql

# ===== TikTok =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://yourdomain.example.com/oauth/tiktok/callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# ===== YouTube / Google =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=22

# ===== social-poster (ไม่บังคับ) =====
# ตั้งครบทั้งสองค่า = publish_approved.py ส่งวิดีโอเป็น "ฉบับร่าง" ไป social-poster (คนกดโพสต์จริงที่นั่น)
# SOCIAL_POSTER_TOKEN = ค่า ADMIN_TOKEN ของ social-poster (ใส่ใน env เท่านั้น ห้ามส่งเข้าแชต)
SOCIAL_POSTER_URL=
SOCIAL_POSTER_TOKEN=

# ===== App =====
DATABASE_PATH=state.db
OUTPUT_DIR=out
LOG_LEVEL=INFO
APPROVAL_REQUIRED=true

# ===== Discord (optional notify) =====
DISCORD_WEBHOOK_URL=

# Image paths must match your verified API response. Default has one image.
SHOPEE_IMAGE_PATHS=imageUrl
# Optional verified GraphQL query; same Fetch/page/limit/nodes response contract.
SHOPEE_PRODUCTS_QUERY_FILE=
# Exact image hostnames from verified API response, comma-separated. Required.
IMAGE_ALLOWED_HOSTS=
IMAGE_MAX_PER_PRODUCT=6
IMAGE_DIR=assets/products
